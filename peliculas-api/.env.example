# =============================================================================
# Archivo de ejemplo de variables de entorno para el backend
# -----------------------------------------------------------------------------
# Copia este archivo como `.env` en local y ajusta los valores según tu entorno.
# NO subas el archivo `.env` real al repositorio.
#
# En producción (despliegue en Render) estos valores NO se leen desde un archivo
# .env, sino que se configuran como variables de entorno del servicio desde el
# panel de Render (Settings > Environment). La base de datos MySQL será remota
# (Aiven o Railway), por lo que DB_HOST, DB_PORT, DB_USER, DB_PASSWORD y DB_NAME
# deben apuntar al host y credenciales proporcionados por ese proveedor.
# =============================================================================

# -----------------------------------------------------------------------------
# Puerto del servidor backend
# -----------------------------------------------------------------------------
# Puerto en el que la aplicación escucha. En Render, el servicio suele inyectar
# su propio puerto; si es necesario, define PORT como variable de entorno.
PORT=3000

# -----------------------------------------------------------------------------
# Configuración de la base de datos MySQL
# -----------------------------------------------------------------------------
# Host o dominio del servidor MySQL. En local suele ser localhost; en producción
# será el host remoto de Aiven o Railway.
DB_HOST=localhost

# Usuario de conexión a la base de datos.
DB_USER=usuario

# Contraseña del usuario de la base de datos. Mantén este valor en secreto.
DB_PASSWORD=contraseña

# Nombre de la base de datos a utilizar.
DB_NAME=nombre_base_de_datos

# Dialecto de la base de datos (ORM). Debe mantenerse en mysql.
DB_DIALECT=mysql

# -----------------------------------------------------------------------------
# Variables opcionales
# -----------------------------------------------------------------------------
# Puerto del servidor MySQL. Por defecto 3306. Algunos proveedores remotos
# (Aiven/Railway) pueden asignar un puerto distinto.
DB_PORT=3306

# Origen(es) permitidos para CORS. Puede ser un dominio único, una lista
# separada por comas o '*' en desarrollo. En producción se recomienda
# restringirlo al dominio real del frontend.
CORS_ORIGIN=http://localhost:5173
